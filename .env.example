# Non-secret runtime configuration only.
COURSE_HTTP_PORT=8080
APP_VERSION=0.1.0-dev
GIT_SHA=local
APP_ENVIRONMENT=course-lab
POSTGRES_DB=delivery
POSTGRES_USER=delivery

# TD3 supplies the password through a protected Docker-owned file volume.
# API and PostgreSQL use POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password.txt.
# No password value belongs in this environment file.

# Parse-only scaffold value for `compose config` before publication.
# Never deploy this mutable placeholder. TD2 records the actual GHCR digest in
# release.env; TD3 onward loads that file before Docker/Compose commands.
DELIVERY_API_IMAGE=delivery-api:local
